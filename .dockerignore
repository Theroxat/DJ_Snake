# Keep secrets out of the image (the token is injected at runtime via env_file).
.env
token
cookies.txt
*.cookies.txt
*.key

# Python virtualenv / caches
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/

# Tests and dev tooling (not needed at runtime)
tests/
pytest.ini
requirements-dev.txt
.pytest_cache/

# Git & CI
.git/
.github/
.gitignore

# Docs & local files
*.md
LICENSE
config.json
.claude/

# Host-side helpers and their logs (they run on the server, not in the image)
scripts/
logs/

# Persistent data (bind-mounted at runtime)
data/

# Downloaded audio
*.mp3
*.mp4
*.wav
*.m4a
*.webm
