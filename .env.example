# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# Your Discord bot token (required)
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: Command prefix (default: !)
COMMAND_PREFIX=!

# Optional: Maximum playlist size (default: 30)
MAX_PLAYLIST_SIZE=30

# Optional: Audio quality for downloads (default: bestaudio/best)
AUDIO_FORMAT=bestaudio/best

# Optional: Temporary directory for downloads (default: system temp)
# TEMP_DIR=/path/to/temp/directory
