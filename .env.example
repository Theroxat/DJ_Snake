# Copy to .env and fill in. Never commit .env.

# Required: Discord bot token
DISCORD_TOKEN=your_bot_token_here

# Command prefix for text commands
COMMAND_PREFIX=!

# Maximum tracks loaded from a playlist
MAX_PLAYLIST_SIZE=30

# Anti-abuse limits on the queue. These are the defaults of every server;
# /limits (Manage Server) overrides them per server. DJs and Manage Server
# members skip the per-member limit and the cooldown.
# Maximum tracks waiting in the queue
# MAX_QUEUE_SIZE=200
# Maximum tracks one member may have waiting (0 = unlimited; the clip page counts as one member)
# MAX_TRACKS_PER_USER=0
# Longest single track in minutes (0 = unlimited)
# MAX_TRACK_MINUTES=0
# Seconds between two /play calls of the same member (0 = none)
# PLAY_COOLDOWN_SECONDS=0

# Optional: yt-dlp format (default: max 720p H.264 + m4a)
# MEDIA_FORMAT=bestvideo[height<=720][vcodec^=avc1]+bestaudio[ext=m4a]/best[height<=720][ext=mp4]/best[height<=720]/best

# Directory for downloaded tracks (default: a fresh temporary directory)
TEMP_DIR=/tmp/dj-snake

# PO token provider URL (default matches docker-compose)
POT_BASE_URL=http://pot-provider:4416

# Port of the clip web page inside the container and on the host
WEB_PORT=47823

# Host IP the web port is published on (docker-compose only).
# 127.0.0.1 = local only; use a LAN IP or 0.0.0.0 for a reverse proxy/tunnel.
WEB_BIND=127.0.0.1

# Public URL of the clip page posted in Discord (empty = http://localhost:WEB_PORT)
PUBLIC_BASE_URL=

# Hours without activity before a web session link expires
SESSION_IDLE_HOURS=6

# Seconds the bot stays in voice once the queue runs out, before leaving
# (30 s instead when no human is left in the channel)
IDLE_DISCONNECT_SECONDS=300

# 24/7 mode: 1 makes servers that never ran `!stay` stay in their voice channel
# (no idle disconnect). `!stay on|off` changes it per server and is saved. The
# bot rejoins the channel it was in after a restart.
STAY_247=0

# Autoplay (radio): 1 plays a related YouTube track when the queue runs out.
# Only the default; `!autoplay on|off` or the clip page changes it per session.
AUTOPLAY=0

# Vote to skip: more than this percent (1-100) of the listeners in the voice
# channel (humans who are not deafened) must run `/voteskip` to skip the track.
# Only the default; `/voteskip threshold <percent>` changes it per server.
VOTESKIP_PERCENT=50

# Persistent data (clip page themes and logos, languages, volumes, DJ roles,
# 24/7 mode, saved playlists, lyrics, listening stats). docker-compose mounts ./data here.
# DATA_DIR=/app/data

# Optional: a server (guild) ID to publish the slash commands to instantly,
# instead of globally (which can take up to an hour). For development.
# SLASH_SYNC_GUILD=

# Default clip page theme for servers that never ran !theme:
# arcade, minimal, night, vinyl, club, terminal, space or cobalt
WEB_THEME=arcade

# Who gets the clip page's control link: everyone (posted in the status
# message next to the view-only link) or dj (only the view-only link is
# posted; DJs get the control link by DM with !weblink). A server with a DJ
# role (!djrole) always behaves as dj.
# WEB_CONTROL=everyone

# Language of the bot's messages and the clip page for servers that never ran
# !language: en, fr, es or de
BOT_LANGUAGE=en

# Optional: Spotify Web API credentials (client credentials flow) to read
# playlists longer than 100 tracks. Without them, Spotify links are read from
# the public embed page (no configuration, 100 tracks max).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Synced lyrics on the clip page, from lrclib.net (1 = on, 0 = off)
LYRICS=1

# Optional: Netscape cookies.txt for age-restricted / members-only videos.
# Use a THROWAWAY Google account (YouTube may ban accounts used by bots).
# Mount the file read-only (see docker-compose.yml); the bot copies it.
# YTDLP_COOKIES=/app/cookies.txt

# Automatic backups of DATA_DIR into DATA_DIR/backups: hours between them
# (0 = off) and how many to keep
BACKUP_INTERVAL_HOURS=0
BACKUP_KEEP=7

# Upgrade yt-dlp on container start (1 = yes, 0 = skip)
YTDLP_AUTO_UPDATE=1

# Serve Prometheus metrics on GET /metrics (1 = yes, 0 = off). /healthz is always on.
METRICS=0

# Optional (docker-compose only): image tag to pull, e.g. 1.0.0 (default: latest)
# DJ_SNAKE_TAG=latest
